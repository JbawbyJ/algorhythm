# ── Algorhythm Environment Variables ──
# Copy this file to .env and fill in your credentials
# NEVER commit .env to git

# ── Server ──
PORT=3001
NODE_ENV=development

# ── eBay API ──
# Get these from: https://developer.ebay.com/my/keys
# Use PRODUCTION keys + EBAY_ENV=PRODUCTION for live Browse (not sandbox).
EBAY_CLIENT_ID=your_ebay_client_id_here
EBAY_CLIENT_SECRET=your_ebay_client_secret_here
EBAY_ENV=SANDBOX   # Change to PRODUCTION when ready

# ── Supabase (add later for auth + user profiles) ──
# SUPABASE_URL=your_supabase_url
# SUPABASE_ANON_KEY=your_supabase_anon_key

# ── SSENSE Affiliate (add when approved) ──
# SSENSE_AFFILIATE_ID=your_id

# ── Live aggregation (live-first) ──
# Local catalog is used only when no live source is configured, or:
ALGORHYTHM_ALLOW_LOCAL=0
LUKES_ENABLED=false
BROWSER_WORKER_URL=
# ALGORHYTHM_PROFILE_PATH=data/profiles.json
# SSENSE_FEED_PATH=
# HBX_FEED_PATH=
# YAHOO_JP_APP_ID=your_id
